# Required: transactional email and owner notifications
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Veriq Digital <noreply@example.com>
BUSINESS_OWNER_EMAIL=owner@example.com

# Required in production: private persistence for website audit state/results
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# Recommended: official Google PageSpeed Insights API (mobile Lighthouse data)
GOOGLE_PAGESPEED_API_KEY=your_google_api_key

# Optional: configure both values to mirror leads to LeadHome
LEADHOME_URL=https://leadhome.example.com
LEADHOME_SOURCE_TOKEN=replace_with_source_token
