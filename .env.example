# Required: transactional email and owner notifications
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Veriq <noreply@example.com>
BUSINESS_OWNER_EMAIL=owner@example.com

# Required in production: attached private Blob store (OIDC is provided by Vercel)
BLOB_STORE_ID=store_your_store_id
# Optional SDK-supported fallback for local or non-Vercel runtimes
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# Website audits default closed in production until every control is configured
WEBSITE_AUDIT_ENABLED=false
WEBSITE_AUDIT_DISCOVERY_ENABLED=false
NEXT_PUBLIC_WEBSITE_AUDIT_DISCOVERY_ENABLED=false
WEBSITE_AUDIT_RETENTION_DAYS=30
WEBSITE_AUDIT_DAILY_RUN_LIMIT=100
WEBSITE_AUDIT_DAILY_EMAIL_LIMIT=100
WEBSITE_AUDIT_HASH_SECRET=replace_with_at_least_32_random_characters
CRON_SECRET=replace_with_at_least_16_random_characters

# Distributed, atomic rate limiting and global quotas
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_standard_server_token

# Required at audit launch: official Google PageSpeed Insights API
GOOGLE_PAGESPEED_API_KEY=your_google_api_key

# Optional outside Vercel: local Chrome/Edge executable for rendered mobile checks
# WEBSITE_AUDIT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: configure both values to mirror leads to LeadHome
LEADHOME_URL=https://leadhome.example.com
LEADHOME_SOURCE_TOKEN=replace_with_source_token
